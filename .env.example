# ====================================================================
# OMNIMARKET AI - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ====================================================================
# Copy this file to '.env' and populate each variable with your actual credentials.
# Do NOT commit your actual '.env' file containing real secrets to GitHub!

# --------------------------------------------------------------------
# 1. SUPABASE CLIENT-SIDE CONFIGURATION (Vite / Frontend)
# --------------------------------------------------------------------
# Your Supabase Project URL (e.g. https://your-project-ref.supabase.co)
# Obtain from: Supabase Dashboard -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anonymous / Public API Key (safe for client-side usage)
# Obtain from: Supabase Dashboard -> Project Settings -> API -> Project API Keys -> 'anon' / 'public'
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --------------------------------------------------------------------
# 2. SUPABASE SERVER-SIDE CONFIGURATION (TanStack Start / SSR Server Functions)
# --------------------------------------------------------------------
# Server-side Supabase URL (same as VITE_SUPABASE_URL)
SUPABASE_URL=https://your-project-id.supabase.co

# Server-side Supabase Anon Key (used by server handlers and edge function calls)
SUPABASE_ANON_KEY=your-supabase-anon-key

# (Optional) Supabase Service Role Key: Required for administrative backend tasks / queue publishing
# WARNING: Keep this strictly secret. Never prefix with VITE_ or expose to browser.
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --------------------------------------------------------------------
# 3. NEXT.JS / COMPATIBILITY FALLBACKS (Optional)
# --------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# --------------------------------------------------------------------
# 4. AI ENGINE CREDENTIALS (Campaign & Content Generation)
# --------------------------------------------------------------------
# Primary Option: DeepSeek Platform API Key
# Sign up and generate an API key at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your-deepseek-api-key
VITE_DEEPSEEK_API_KEY=your-deepseek-api-key

# Secondary / Fallback Option: Google AI Studio API Key (Gemini Models)
# Sign up and generate an API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-google-gemini-api-key
GOOGLE_AI_STUDIO_API_KEY=your-google-gemini-api-key
VITE_GEMINI_API_KEY=your-google-gemini-api-key

# --------------------------------------------------------------------
# 5. OAUTH SOCIAL PLATFORM APP CREDENTIALS (Optional - for token refresh)
# --------------------------------------------------------------------
# Google / YouTube OAuth App (Google Cloud Console: https://console.cloud.google.com/)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# X (Twitter) Developer Portal (https://developer.x.com/)
# X_CLIENT_ID=your-x-client-id
# X_CLIENT_SECRET=your-x-client-secret
